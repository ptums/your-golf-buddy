# Copy to .env.local for local development.
#
# NEXT_PUBLIC_* values are inlined at build time (`next build`), not read at
# runtime. In CI the deploy workflow sets these from repo variables before
# building. See docs/deploy.md.

# Base URL of the profile-sync service. cloud-sync.ts appends /sync/*.
# Local:      http://localhost:8787/api
# Production: https://ygb-profile-sync.<account>.workers.dev/api
NEXT_PUBLIC_SYNC_ENDPOINT=http://localhost:8787/api

# Base URL of the course-ls service (golf-course typeahead). Optional — if unset,
# the new-course form is a plain text field. course-search.ts appends
# /courses/search.
# Local:      http://localhost:8788   (run course-ls on a second port)
# Production: https://ygb-course-ls.<account>.workers.dev
NEXT_PUBLIC_COURSE_LS_ENDPOINT=http://localhost:8788
