# Copy to .env.local for local development.
#
# NEXT_PUBLIC_* values are inlined at build time (`next build`), not read at
# runtime. In CI the deploy workflow sets NEXT_PUBLIC_SYNC_ENDPOINT from a repo
# variable before building. See docs/deploy.md.

# Base URL of the profile-sync service. cloud-sync.ts appends /sync/*.
# Local:      http://localhost:8787/api   (services/profile-sync via `wrangler dev`)
# Production: https://ygb-profile-sync.<account>.workers.dev/api  (or a custom domain)
NEXT_PUBLIC_SYNC_ENDPOINT=http://localhost:8787/api
