{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygb-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // NEXT_PUBLIC_SYNC_ENDPOINT is a *build-time* value (inlined by `next build`),
  // not a Worker var — it is set in the deploy workflow's build job env / a
  // local .env file. See env.example and docs/deploy.md.
}
