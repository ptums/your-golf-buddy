{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start --port 3004",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx lib/seed.ts",
