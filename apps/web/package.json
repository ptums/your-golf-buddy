    "@tanstack/react-virtual": "^3.13.6",
    "@ygb/shared": "workspace:*",
    "autoprefixer": "^10.4.21",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "idb": "^8.0.3",
    "next": "^15.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "wrangler": "^4.129.1"
