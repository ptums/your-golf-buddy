{
  "name": "course-ls",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Course Location Service — nearby golf-course lookup with location-bucketed caching (prototype, mock data).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler types && tsc --noEmit && wrangler deploy --dry-run --outdir=dist",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint src",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "eslint": "^9",
    "typescript": "^5.9.2",
    "wrangler": "^4.129.1"
  }
}
