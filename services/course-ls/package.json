{
  "name": "course-ls",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Course Location Service — golf-course typeahead search wrapping the Google Places API, with a two-tier edge cache.",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 0",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@ygb/shared": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^5.9.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.129.1"
  }
}
