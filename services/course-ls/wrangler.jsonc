{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygb-course-ls",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "COURSE_CACHE",
      // `wrangler kv namespace create COURSE_CACHE` → paste the id here.
      // The service still runs without it (edge cache only). See docs/deploy.md.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
  // GOOGLE_MAPS_API_KEY is a secret: `wrangler secret put GOOGLE_MAPS_API_KEY`
  // (locally: put it in .dev.vars). Without it, /courses/search returns 503.
}
