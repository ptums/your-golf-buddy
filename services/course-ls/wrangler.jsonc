{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygb-course-ls",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Uncomment once the yourbuddy.golf zone is Active (see docs/custom-domain.md).
  // "routes": [{ "pattern": "courses.yourbuddy.golf", "custom_domain": true }],
  "vars": {
    // Browsers allowed to call this API. curl / server-to-server is unaffected.
    "CORS_ORIGINS": "https://yourbuddy.golf,https://www.yourbuddy.golf,https://ygb-web.peter-686.workers.dev,http://localhost:3002"
  },
  "kv_namespaces": [
    {
      "binding": "COURSE_CACHE",
      "id": "282f917e7e1646f587d4f04c2a9a8e43"
    }
  ]
  // GOOGLE_MAPS_API_KEY is a secret: `pnpm cf:secret:google`
  // (locally: `pnpm env:sync` writes it to .dev.vars). Without it,
  // /courses/search returns 503.
}
