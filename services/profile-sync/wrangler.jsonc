{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygb-profile-sync",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "api.yourbuddy.golf", "custom_domain": true }],
  // Nightly D1 -> R2 backup (03:17 UTC). Handler: scheduled() in src/index.ts.
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    // Browsers allowed to call this API. During the marketing-site transition
    // the app answers on both the apex and app.yourbuddy.golf; drop the apex and
    // the *.workers.dev entry once the app is only on app.yourbuddy.golf.
    "CORS_ORIGINS": "https://yourbuddy.golf,https://www.yourbuddy.golf,https://app.yourbuddy.golf,https://ygb-web.peter-686.workers.dev,http://localhost:3002",
    // Golf Buddy Pass feature flags — both dark. See docs/pass.md for launch.
    // PASS_ENABLED  -> POST /pass/claim issues passes (needs STRIPE_SECRET_KEY + PASS_SECRET secrets).
    // PASS_ENFORCED -> /sync/* requires a valid X-Golf-Pass header.
    "PASS_ENABLED": "false",
    "PASS_ENFORCED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ygb-profile-sync",
      "database_id": "ee1fc1f0-e3e4-439d-a427-357b09c56d5e",
      "migrations_dir": "migrations"
    }
  ],
  // Backup target for the nightly D1 dump. Create with `pnpm cf:r2:create`.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "ygb-backups"
    }
  ],
  // Client-error telemetry sink for POST /log (see src/index.ts).
  "analytics_engine_datasets": [
    {
      "binding": "TELEMETRY",
      "dataset": "ygb_client_errors"
    }
  ],
  // Coarse abuse limiters. namespace_id is just a stable identifier you pick;
  // no resource to provision. SYNC_LIMITER is keyed by the caller's profile
  // token (src/auth.ts); LOG_LIMITER is keyed by client IP (POST /log).
  "ratelimits": [
    {
      "name": "SYNC_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "LOG_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
