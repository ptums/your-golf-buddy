{
  "name": "profile-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler types && tsc --noEmit && wrangler deploy --dry-run --outdir=dist",
    "check": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ygb-profile-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply ygb-profile-sync --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@ygb/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "typescript": "^5.9.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.129.1"
  }
}
