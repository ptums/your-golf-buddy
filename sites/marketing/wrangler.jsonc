{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygb-marketing",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  // Static-assets-only Worker (no `main`). `astro build` emits ./dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "yourbuddy.golf", "custom_domain": true },
    { "pattern": "www.yourbuddy.golf", "custom_domain": true }
  ]
}
