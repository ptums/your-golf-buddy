{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygb-marketing",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  // Static-assets-only Worker (no `main`). `astro build` emits ./dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // Phase 3 (docs/marketing-site.md): add the apex routes here and remove
  // `yourbuddy.golf` from apps/web/wrangler.jsonc in the same deploy —
  //   "routes": [
  //     { "pattern": "yourbuddy.golf", "custom_domain": true },
  //     { "pattern": "www.yourbuddy.golf", "custom_domain": true }
  //   ]
  // Until then this deploys to ygb-marketing.<subdomain>.workers.dev.
}
