---
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL, CONTACT_EMAIL } from "../data/site";

// Post-purchase landing page. Phase 4: static stub explaining activation.
// Phase 5 turns this into a Worker route that reads ?session_id=, verifies the
// Stripe Checkout session, and shows the issued pass key inline.
---

<BaseLayout
  title="Welcome — Your Golf Buddy Pass"
  description="Activate your Golf Buddy Pass and turn on cloud sync."
  path="/welcome"
  noindex
>
  <main class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="text-3xl font-bold text-slate-900">Thanks — you're set</h1>
    <p class="mt-3 text-slate-600">
      Your Golf Buddy Pass unlocks cloud sync across all your devices. Here's how
      to turn it on.
    </p>

    <div
      class="mt-8 rounded-xl border border-dashed border-amber-300 bg-amber-50 p-5 text-sm text-amber-900"
    >
      <p class="font-semibold">Your pass key</p>
      <p class="mt-1">
        Automatic key delivery isn't switched on yet. For now, email
        <a class="underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        with your payment receipt and you'll get your key back the same day.
      </p>
    </div>

    <ol class="mt-8 space-y-4">
      <li class="rounded-xl border border-amber-200 bg-white/70 p-5">
        <p class="font-semibold text-slate-900">1. Open Your Golf Buddy</p>
        <p class="mt-1 text-sm text-slate-600">
          On the device you play with. <a
            class="underline hover:text-slate-900"
            href={APP_URL}>{APP_URL.replace("https://", "")}</a
          >
        </p>
      </li>
      <li class="rounded-xl border border-amber-200 bg-white/70 p-5">
        <p class="font-semibold text-slate-900">
          2. Go to Settings → Golf Buddy Pass
        </p>
        <p class="mt-1 text-sm text-slate-600">
          Paste your pass key into the field and save.
        </p>
      </li>
      <li class="rounded-xl border border-amber-200 bg-white/70 p-5">
        <p class="font-semibold text-slate-900">3. Turn on sync</p>
        <p class="mt-1 text-sm text-slate-600">
          Flip the sync switch. Your rounds back up right away and stay in step
          on every device where you enter the same key.
        </p>
      </li>
    </ol>

    <p class="mt-8 text-sm text-slate-600">
      Stuck? Email <a
        class="underline hover:text-slate-900"
        href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
      > and we'll sort it out.
    </p>
  </main>
</BaseLayout>
