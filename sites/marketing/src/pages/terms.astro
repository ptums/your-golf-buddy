---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL, PRICE_LABEL } from "../data/site";
---

<BaseLayout
  title="Terms — Your Golf Buddy"
  description="Terms of use for Your Golf Buddy and the Golf Buddy Pass."
  path="/terms"
>
  <main class="mx-auto max-w-2xl px-6 py-16 prose prose-slate">
    <h1>Terms</h1>
    <p>Last updated {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long" })}.</p>
    <p>
      Your Golf Buddy is provided as-is, with no warranty. The free app stores
      your data on your device; keep your own backups of anything important.
    </p>
    <h2>Golf Buddy Pass</h2>
    <p>
      The Golf Buddy Pass is a one-time {PRICE_LABEL} purchase that unlocks cloud
      sync. It is tied to the pass key you receive after payment, not to an
      account. Because it is a digital good delivered immediately, purchases are
      non-refundable except where required by law — if sync isn't working for
      you, contact us first and we'll sort it out.
    </p>
    <h2>Contact</h2>
    <p>Questions: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
  </main>
</BaseLayout>
