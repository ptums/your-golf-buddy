---
import BaseLayout from "../layouts/BaseLayout.astro";

const APP_URL = "https://app.yourbuddy.golf";
// Stripe Payment Link — set in phase 5.
const BUY_URL = APP_URL;

const title = "Your Golf Buddy — offline golf scorecard & notes";
const description =
  "A free, offline-first golf scorecard app. Track every round, keep notes on every hole, work on your clubs. No account, no email. A one-time $9 pass adds cloud sync across devices.";
---

<BaseLayout title={title} description={description} path="/">
  <main class="mx-auto max-w-5xl px-6">
    <section class="flex flex-col items-center gap-6 py-20 text-center sm:py-28">
      <p class="rounded-full border border-amber-300 bg-amber-100/60 px-3 py-1 text-xs font-medium tracking-wide text-amber-800 uppercase">
        Works offline · No account
      </p>
      <h1 class="max-w-2xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Track every round. Keep every note.
      </h1>
      <p class="max-w-xl text-lg text-slate-600">
        Your Golf Buddy is a simple scorecard you actually want to use on the
        course — par, score, and putts hole by hole, plus a note for how the
        round felt. Everything stays on your device.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={APP_URL}
          class="rounded-lg bg-[var(--color-brand)] px-5 py-3 font-semibold text-white transition hover:bg-[var(--color-brand-dark)]"
        >
          Open the app
        </a>
        <a
          href={BUY_URL}
          class="rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-800 transition hover:border-slate-400"
        >
          Get the Pass — $9
        </a>
      </div>
    </section>

    <section class="grid gap-6 pb-24 sm:grid-cols-3">
      {
        [
          {
            h: "Score in seconds",
            p: "Tap in par, strokes, and putts. Your running total updates as you play.",
          },
          {
            h: "Yours, on your device",
            p: "No sign-up, no email address. Your rounds live in the app and work with no signal.",
          },
          {
            h: "Sync when you want it",
            p: "A one-time $9 pass backs your rounds up and syncs them across your phones and tablets.",
          },
        ].map((c) => (
          <div class="rounded-xl border border-amber-200 bg-white/70 p-6">
            <h2 class="mb-1 font-semibold text-slate-900">{c.h}</h2>
            <p class="text-sm text-slate-600">{c.p}</p>
          </div>
        ))
      }
    </section>
  </main>
</BaseLayout>
