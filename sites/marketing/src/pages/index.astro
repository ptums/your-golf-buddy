---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import {
  APP_URL,
  SITE_URL,
  BUY_URL,
  PASS_ENABLED,
  PRICE,
  PRICE_LABEL,
  features,
  steps,
  faqs,
} from "../data/site";

const title = "Your Golf Buddy — offline golf scorecard & notes";
const description = PASS_ENABLED
  ? "A free, offline-first golf scorecard app. Track par, score, and putts hole by hole, keep a note on every round, and see your game trend. No account, no email. A one-time $9 pass adds cloud sync across devices."
  : "A free, offline-first golf scorecard app. Track par, score, and putts hole by hole, keep a note on every round, and see your game trend. No account, no email, no ads.";

const offers = [
  {
    "@type": "Offer",
    name: "Free",
    price: "0",
    priceCurrency: "USD",
    description: "The full app, no account.",
  },
  ...(PASS_ENABLED
    ? [
        {
          "@type": "Offer",
          name: "Golf Buddy Pass",
          price: String(PRICE),
          priceCurrency: "USD",
          description:
            "One-time purchase — cloud sync and backup across devices.",
          url: BUY_URL,
        },
      ]
    : []),
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Your Golf Buddy",
    applicationCategory: "SportsApplication",
    operatingSystem: "Web, iOS, Android",
    url: SITE_URL,
    description,
    offers,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Your Golf Buddy",
    url: SITE_URL,
    logo: `${SITE_URL}/favicon.svg`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Your Golf Buddy",
    url: SITE_URL,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <main class="mx-auto max-w-5xl px-6">
    <!-- Hero -->
    <section class="py-20 sm:py-28">
      <p class="bs-rail">Works offline · No account · No ads</p>
      <h1 class="mt-4 max-w-3xl text-[44px] leading-[0.95] tracking-[-0.02em] sm:text-[64px]">
        Track every round.<br />Keep every note.
      </h1>
      <p class="mt-5 max-w-xl text-[18px] text-[var(--color-n800)]">
        Your Golf Buddy is a scorecard you actually want to pull out on the
        course — par, strokes, and putts hole by hole, plus a note for how the
        round felt. Everything stays on your device.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={APP_URL} class="bs-key bs-key-ink">Open the app — free</a>
        {PASS_ENABLED && (
          <a href="#pricing" class="bs-key">See the {PRICE_LABEL} Pass</a>
        )}
      </div>
      <p class="mt-4 text-[13px] text-[var(--color-n500)]">
        No sign-up. Add it to your home screen and play.
      </p>
    </section>

    <!-- Features -->
    <section id="features" class="scroll-mt-24 border-t-[1.5px] border-[var(--color-ink)] py-16">
      <h2 class="mb-10 text-[32px]">Everything a round needs, nothing it doesn't</h2>
      <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((c) => (
            <div>
              <h3 class="text-[18px]">{c.title}</h3>
              <p class="mt-1 text-[15px] leading-relaxed text-[var(--color-n800)]">
                {c.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="scroll-mt-24 border-t-[1.5px] border-[var(--color-ink)] py-16">
      <h2 class="mb-10 text-[32px]">How it works</h2>
      <ol class="grid gap-x-10 gap-y-8 sm:grid-cols-3">
        {
          steps.map((s, i) => (
            <li>
              <span class="font-sans text-[22px] font-semibold">{i + 1}</span>
              <h3 class="mt-1 text-[18px]">{s.title}</h3>
              <p class="mt-1 text-[15px] leading-relaxed text-[var(--color-n800)]">
                {s.body}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-[15px] text-[var(--color-n800)]">
        There's a full walkthrough in the app under{" "}
        <a class="underline" href={`${APP_URL}/how-to`}>How to use Your Golf Buddy</a>.
      </p>
    </section>

    <!-- Privacy -->
    <section class="border-t-[1.5px] border-[var(--color-ink)] py-16">
      <div class="bs-box p-8 sm:p-10">
        <h2 class="mb-3 text-[26px]">Your data doesn't leave your phone</h2>
        <p class="max-w-2xl text-[16px] text-[var(--color-n800)]">
          No account, no email address, no password. Your profile is just a
          username stored in your browser. This site sets no cookies and runs no
          analytics or trackers. If you turn on sync, your rounds are backed up
          against a random key generated on your device — never your name — and
          you can wipe that copy from the app whenever you want.
        </p>
      </div>
    </section>

    {
      PASS_ENABLED && (
        <section id="pricing" class="scroll-mt-24 border-t-[1.5px] border-[var(--color-ink)] py-16">
          <h2 class="mb-2 text-[32px]">Pricing</h2>
          <p class="mb-10 text-[16px] text-[var(--color-n800)]">
            The app is free. Pay once, only if you want your rounds on more than
            one device.
          </p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="bs-box p-8">
              <h3 class="text-[16px]">Free</h3>
              <p class="mt-1 font-sans text-[34px] font-semibold">$0</p>
              <ul class="mt-5 space-y-2 text-[15px] text-[var(--color-n800)]">
                <li>Full scoring, notes, and history</li>
                <li>Swing tips and practice drills</li>
                <li>Works offline, installable</li>
                <li>Recovery key to move devices</li>
              </ul>
              <a href={APP_URL} class="bs-key mt-6 !px-4 !py-2 text-[14px]">
                Open the app
              </a>
            </div>
            <div class="bs-box border-[2.5px] p-8">
              <span class="bs-flag">Golf Buddy Pass</span>
              <p class="mt-3 font-sans text-[34px] font-semibold">
                {PRICE_LABEL}
                <span class="text-[16px] font-normal text-[var(--color-n500)]"> once</span>
              </p>
              <ul class="mt-5 space-y-2 text-[15px] text-[var(--color-n800)]">
                <li>Everything in Free</li>
                <li>Cloud sync across all your devices</li>
                <li>Automatic off-device backup</li>
                <li>One payment — no subscription</li>
              </ul>
              <a href={BUY_URL} class="bs-key bs-key-ink mt-6 !px-4 !py-2 text-[14px]">
                Get the Pass
              </a>
            </div>
          </div>
        </section>
      )
    }

    <Faq />

    <!-- Final CTA -->
    <section class="border-t-[1.5px] border-[var(--color-ink)] py-16">
      <div class="bs-key-ink rounded-[2px] p-10 text-center">
        <h2 class="text-[26px]">Play your next round with it</h2>
        <p class="mx-auto mt-2 max-w-md text-[15px] text-[var(--color-n300)]">
          Free, offline, and ready in the time it takes to walk to the first tee.
        </p>
        <a
          href={APP_URL}
          class="bs-key mt-6 border-[var(--color-paper)] bg-[var(--color-paper)] text-[var(--color-ink)]"
        >
          Open Your Golf Buddy
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
