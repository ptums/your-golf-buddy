---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Your Golf Buddy"
  description="That page doesn't exist."
  path="/404"
>
  <main class="mx-auto flex max-w-5xl flex-col items-start gap-4 px-6 py-28">
    <h1 class="text-[42px] leading-[0.95]">Page not found</h1>
    <p class="text-[16px] text-[var(--color-n800)]">That page doesn't exist.</p>
    <a href="/" class="bs-key bs-key-ink mt-2">Back home</a>
  </main>
</BaseLayout>
