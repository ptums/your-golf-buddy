---
import "../styles/global.css";
import { APP_URL, PASS_ENABLED } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Path-only, e.g. "/privacy". Defaults to the current page. */
  path?: string;
  /** JSON-LD objects to embed in <head>. */
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search indexes (thin / transactional pages). */
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href.replace(
  /\/$/,
  "",
);
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Your Golf Buddy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd.map((obj) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(obj)}
        />
      ))
    }
  </head>
  <body class="min-h-screen bg-[var(--color-paper)] text-[var(--color-ink)]">
    <header class="sticky top-0 z-10 bg-[var(--color-paper)]">
      <div class="mx-auto max-w-5xl px-6 pt-4">
        <div class="bs-rule"></div>
        <div class="flex items-center justify-between py-[9px]">
          <a href="/" class="bs-rail bs-rail-ink no-underline">Your Golf Buddy</a>
          <nav class="hidden items-center gap-5 sm:flex">
            <a class="bs-rail no-underline hover:underline" href="/#features">Features</a>
            <a class="bs-rail no-underline hover:underline" href="/#how">How it works</a>
            {PASS_ENABLED && (
              <a class="bs-rail no-underline hover:underline" href="/#pricing">Pricing</a>
            )}
            <a class="bs-rail no-underline hover:underline" href="/#faq">FAQ</a>
          </nav>
          <a href={APP_URL} class="bs-key bs-key-ink !px-4 !py-2 text-[13px]">
            Open the app
          </a>
        </div>
        <div class="bs-rule-thin"></div>
      </div>
    </header>

    <slot />

    <footer class="mx-auto mt-16 max-w-5xl px-6">
      <div class="bs-rule"></div>
      <div
        class="flex flex-col gap-2 py-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="bs-rail">© {new Date().getFullYear()} Your Golf Buddy</p>
        <nav class="flex gap-4">
          <a class="bs-rail no-underline hover:underline" href={APP_URL}>Open the app</a>
          <a class="bs-rail no-underline hover:underline" href="/privacy">Privacy</a>
          <a class="bs-rail no-underline hover:underline" href="/terms">Terms</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
