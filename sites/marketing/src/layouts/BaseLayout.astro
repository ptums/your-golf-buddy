---
import "../styles/global.css";
import { APP_URL } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Path-only, e.g. "/privacy". Defaults to the current page. */
  path?: string;
  /** JSON-LD objects to embed in <head>. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, jsonLd = [] } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site).href.replace(
  /\/$/,
  "",
);
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Your Golf Buddy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      jsonLd.map((obj) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(obj)}
        />
      ))
    }
  </head>
  <body
    class="min-h-screen bg-[var(--color-ground)] font-sans text-slate-900 antialiased"
  >
    <header
      class="sticky top-0 z-10 border-b border-amber-200/70 bg-[var(--color-ground)]/85 backdrop-blur"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3"
      >
        <a href="/" class="flex items-center gap-2 font-semibold text-slate-900">
          <img src="/favicon.svg" alt="" width="24" height="24" />
          Your Golf Buddy
        </a>
        <nav class="hidden items-center gap-6 text-sm text-slate-600 sm:flex">
          <a class="hover:text-slate-900" href="/#features">Features</a>
          <a class="hover:text-slate-900" href="/#how">How it works</a>
          <a class="hover:text-slate-900" href="/#pricing">Pricing</a>
          <a class="hover:text-slate-900" href="/#faq">FAQ</a>
        </nav>
        <a
          href={APP_URL}
          class="rounded-lg bg-[var(--color-brand)] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[var(--color-brand-dark)]"
        >
          Open the app
        </a>
      </div>
    </header>

    <slot />

    <footer
      class="border-t border-amber-200/70 px-6 py-10 text-sm text-slate-600"
    >
      <div
        class="mx-auto flex max-w-5xl flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {new Date().getFullYear()} Your Golf Buddy</p>
        <nav class="flex gap-4">
          <a class="hover:text-slate-900" href={APP_URL}>Open the app</a>
          <a class="hover:text-slate-900" href="/privacy">Privacy</a>
          <a class="hover:text-slate-900" href="/terms">Terms</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
