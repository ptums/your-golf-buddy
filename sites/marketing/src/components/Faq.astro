---
import { faqs } from "../data/site";
---

<section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-6 py-20">
  <h2 class="mb-8 text-3xl font-bold text-slate-900">Questions</h2>
  <div class="divide-y divide-amber-200 rounded-xl border border-amber-200 bg-white/70">
    {
      faqs.map((f) => (
        <details class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-slate-900">
            {f.q}
            <span class="text-slate-400 transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
