---
import { faqs } from "../data/site";
---

<section
  id="faq"
  class="scroll-mt-24 border-t-[1.5px] border-[var(--color-ink)] py-16"
>
  <h2 class="mb-8 text-[32px]">Questions</h2>
  <div class="border-t-[1.5px] border-[var(--color-ink)]">
    {
      faqs.map((f) => (
        <details class="group border-b-[1.5px] border-[var(--color-n400)] py-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-[17px] font-semibold">
            {f.q}
            <span class="text-[var(--color-n500)] transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-n800)]">
            {f.a}
          </p>
        </details>
      ))
    }
  </div>
</section>
