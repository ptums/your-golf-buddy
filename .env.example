# ──────────────────────────────────────────────────────────────────────────
# Your Golf Buddy — single local config file.
#
#   1. cp .env.example .env
#   2. fill in the values below
#   3. pnpm env:sync        # fans these out to the per-tool files
#
# .env is gitignored. Never commit real keys.
# ──────────────────────────────────────────────────────────────────────────

# ── Cloudflare ────────────────────────────────────────────────────────────
# Only needed to run `wrangler deploy` / `d1` / `kv` from your machine
# (`pnpm deploy`, `pnpm cf:*`). Or leave blank and run
# `pnpm --filter profile-sync exec wrangler login` once instead.
#
# API token:  dash.cloudflare.com → My Profile → API Tokens  (see docs/deploy.md)
# Account ID: any domain → Overview → right sidebar
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Google Places (course-ls typeahead) ──────────────────────────────────
# Google Cloud console → enable "Places API (New)" → Credentials → API key
GOOGLE_MAPS_API_KEY=

# ── Web build-time URLs (inlined by `next build`) ────────────────────────
# Where apps/web looks for the two services. Defaults assume local wrangler dev.
# Production values go in GitHub repo *variables* (see docs/deploy.md):
#   NEXT_PUBLIC_SYNC_ENDPOINT      = https://api.yourbuddy.golf
#   NEXT_PUBLIC_COURSE_LS_ENDPOINT = https://courses.yourbuddy.golf
NEXT_PUBLIC_SYNC_ENDPOINT=http://localhost:8787/api
NEXT_PUBLIC_COURSE_LS_ENDPOINT=http://localhost:8788

# ── Golf Buddy Pass (paid cloud sync) — all dark until launch ────────────
# See docs/pass.md. Leave unset for the current "free" behaviour.
#   NEXT_PUBLIC_PASS_ENABLED   web: shows the "Golf Buddy Pass" field in Settings
#   PUBLIC_PASS_ENABLED        marketing: shows pricing / buy CTAs / pass FAQ
#   PUBLIC_STRIPE_PAYMENT_LINK marketing: the Stripe Payment Link URL
NEXT_PUBLIC_PASS_ENABLED=
PUBLIC_PASS_ENABLED=
PUBLIC_STRIPE_PAYMENT_LINK=
